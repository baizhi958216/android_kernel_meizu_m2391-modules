KERNEL_SRC ?= /lib/modules/$(shell uname -r)/build
M ?= $(CURDIR)
MO ?= $(OUT_DIR)/$(M)

KBUILD_OPTIONS :=
KBUILD_OPTIONS += ANDROID_BUILD_TOP=
KBUILD_OPTIONS += WLAN_PLATFORM_ROOT=$(abspath $(KERNEL_SRC)/$(M)/../platform)
KBUILD_OPTIONS += WLAN_ROOT=$(abspath $(KERNEL_SRC)/$(M))
KBUILD_OPTIONS += WLAN_COMMON_ROOT=cmn
KBUILD_OPTIONS += WLAN_COMMON_INC=$(abspath $(KERNEL_SRC)/$(M)/../qca-wifi-host-cmn)
KBUILD_OPTIONS += WLAN_FW_API=$(abspath $(KERNEL_SRC)/$(M)/../fw-api)
KBUILD_OPTIONS += WLAN_PROFILE=kiwi_v2
KBUILD_OPTIONS += DYNAMIC_SINGLE_CHIP=kiwi_v2
KBUILD_OPTIONS += DEVNAME=kiwi_v2
KBUILD_OPTIONS += WLAN_CTRL_NAME=wlan
KBUILD_OPTIONS += CONFIG_QCA_CLD_WLAN=m
KBUILD_OPTIONS += CONFIG_BUS_AUTO_SUSPEND=y
KBUILD_OPTIONS += CONFIG_ARCH_KALAMA=y
KBUILD_OPTIONS += CONFIG_CNSS_OUT_OF_TREE=y
KBUILD_OPTIONS += CONFIG_CNSS2=m
KBUILD_OPTIONS += CONFIG_CNSS2_QMI=y
KBUILD_OPTIONS += CONFIG_CNSS_UTILS=m
KBUILD_OPTIONS += CONFIG_CNSS_GENL=m
KBUILD_OPTIONS += CONFIG_WCNSS_MEM_PRE_ALLOC=m
KBUILD_OPTIONS += CONFIG_CNSS_QMI_SVC=m
KBUILD_OPTIONS += CONFIG_CNSS_PLAT_IPC_QMI_SVC=m
KBUILD_OPTIONS += CONFIG_CNSS_HW_SECURE_DISABLE=y
KBUILD_OPTIONS += BOARD_PLATFORM=kalama
KBUILD_OPTIONS += MODNAME=kiwi_v2

all: modules

modules:
	$(MAKE) -C $(KERNEL_SRC) M=$(M) MO=$(MO) modules $(KBUILD_OPTIONS) KBUILD_EXTRA_SYMBOLS="$(OUT_DIR)/../m2391-modules/qcom/opensource/wlan/platform/Module.symvers"

modules_install:
	$(MAKE) -C $(KERNEL_SRC) M=$(M) MO=$(MO) INSTALL_MOD_STRIP=1 modules_install $(KBUILD_OPTIONS) KBUILD_EXTRA_SYMBOLS="$(OUT_DIR)/../m2391-modules/qcom/opensource/wlan/platform/Module.symvers"

clean:
	$(MAKE) -C $(KERNEL_SRC) M=$(M) MO=$(MO) clean $(KBUILD_OPTIONS) KBUILD_EXTRA_SYMBOLS="$(OUT_DIR)/../m2391-modules/qcom/opensource/wlan/platform/Module.symvers"

.PHONY: all modules modules_install clean
